                interpolation = "faceVarying"
            )
            uniform token physics:approximation = "convexHull"
            point3f[] points = [(-1.03, -0.45, 0), (-1.03, -0.45, 2.3), (-1.03, 0.751, 0), (-1.03, 0.751, 2.3), (-1.019, -0.45, 0), (-1.019, -0.45, 2.3), (-1.019, 0.751, 0), (-1.019, 0.751, 2.3)]
