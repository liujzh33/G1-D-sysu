            point3f[] points = [(1.02, -0.45, 0), (1.02, -0.45, 2.3), (1.02, 0.751, 0), (1.02, 0.751, 2.3), (1.031, -0.45, 0), (1.031, -0.45, 2.3), (1.031, 0.751, 0), (1.031, 0.751, 2.3)]
            uniform token purpose = "guide"
            uniform token subdivisionScheme = "none"
        }
